<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="remove-status-column" author="kebabslutzz">
    <!-- Before dropping the column, we need to drop the check constraint first -->
    <sql>
      ALTER TABLE users DROP CONSTRAINT users_status_check;
    </sql>

    <dropColumn
      tableName="users"
      columnName="status"/>

    <rollback>
      <addColumn tableName="users">
        <column name="status" type="varchar(255)">
          <constraints nullable="false"/>
        </column>
      </addColumn>

      <sql>
        ALTER TABLE users ADD CONSTRAINT users_status_check CHECK (status IN ('NOT_ACTIVE', 'ACTIVE'));
      </sql>
    </rollback>
  </changeSet>

</databaseChangeLog>
