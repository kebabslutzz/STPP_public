<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="1" author="kasparas.putrius">
    <addUniqueConstraint columnNames="username" tableName="users" constraintName="unique_username"/>
    <addUniqueConstraint columnNames="email" tableName="users" constraintName="unique_email"/>

    <rollback>
      <dropUniqueConstraint columnNames="username" tableName="users" constraintName="unique_username"/>
      <dropUniqueConstraint columnNames="email" tableName="users" constraintName="unique_email"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
