root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.java]
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
